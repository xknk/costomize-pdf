{
  "name": "customize-pdf-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "build:app": "vite build",
    "build": "pnpm run build:packages && pnpm run build:app",
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@customize-pdf/viewer": "workspace:*",
    "@customize-pdf/vue": "workspace:*",
    "vue": "^3.4.0",
    "element-plus": "^2.9.7",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.4.0",
    "vite": "^5.0.7",
    "typescript": "^5.3.3",
    "vue-tsc": "^1.8.27"
  }
}
