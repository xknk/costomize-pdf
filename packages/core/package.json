{
  "name": "@customize-pdf/core",
  "version": "0.0.1",
  "type": "module",
  "description": "核心PDF渲染引擎，包含虚拟滚动、Worker渲染池、Canvas池等性能优化",
  "main": "./dist/core.umd.js",
  "module": "./dist/core.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core.es.js",
      "require": "./dist/core.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "2.16.105"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "2.16.105",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  },
  "keywords": [
    "pdf",
    "renderer",
    "virtual-scroll",
    "worker",
    "canvas"
  ],
  "license": "MIT"
}
